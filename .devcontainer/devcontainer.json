{
  "name": "Constructra Development",

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "default"
    },
    "ghcr.io/devcontainers-extra/features/pnpm:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y build-essential curl wget file libssl-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libwebkit2gtk-4.1-dev && rustup component add rustfmt clippy && pnpm install || true",

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "jinxdash.prettier-rust",

        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",

        "usernamehw.errorlens",
        "vscode-icons-team.vscode-icons",
        "eamodio.gitlens",

        "ultram4rine.vscode-choosealicense"
      ],

      "settings": {
        "editor.bracketPairColorization.enabled": true,
        "editor.cursorBlinking": "phase",
        "editor.cursorSmoothCaretAnimation": "on",
        "editor.guides.bracketPairs": "active",
        "editor.guides.bracketPairsHorizontal": true,
        "editor.wordWrap": "on",
        "editor.formatOnSave": true,

        "editor.defaultFormatter": "esbenp.prettier-vscode",

        "explorer.compactFolders": false,

        "files.encoding": "utf8",

        "license.author": "Killer88967",
        "license.default": "apache-2.0",

        "workbench.colorTheme": "Dark Modern",
        "workbench.iconTheme": "vscode-icons",

        "chat.mcp.gallery.enabled": true,
        "chat.mcp.access": "all",

        "files.associations": {
          "*.json": "json",
          "*.css": "tailwindcss"
        },

        "files.exclude": {
          "**/node_modules": true,
          "**/target": true
        },

        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer",
          "editor.formatOnSave": true
        },

        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },

        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },

        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },

        "[javascriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },

        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },

  "forwardPorts": [1420, 3000, 5173],

  "portsAttributes": {
    "1420": {
      "label": "Tauri / Vite"
    },
    "3000": {
      "label": "Development Server"
    },
    "5173": {
      "label": "Vite"
    }
  },

  "remoteUser": "vscode"
}
